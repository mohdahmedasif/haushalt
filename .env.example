# Copy to `.env`.

# Admin key: typed once per browser to pair it, and to reset a forgotten PIN.
# Leave it unset and the app generates one on first start and saves it to
# data/admin.key. Use a long random value if the app is reachable from the internet.
# KEY=

PORT=8787

# Only behind a reverse proxy (Caddy, nginx, Cloudflare Tunnel): the number of
# proxies in front of the app, so rate limiting sees the visitor's real address.
# Without it, rate limits become shared: the 20 pairing attempts per 5 minutes
# count everyone together, so someone hammering the pairing screen could block
# you from pairing a new device for a few minutes. Guessing stays capped as hard.
# TRUST_PROXY=1
